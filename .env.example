# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/behsa_digital

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SEO / Indexing (set to true for staging/test environments)
SITE_NOINDEX=false

# Initial CMS Admin User (used by: npm run admin:create)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=مدیر سیستم

# Secret for POST /api/revalidate (Authorization: Bearer <secret>). Unset = route disabled.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
REVALIDATE_SECRET=
